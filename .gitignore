cursor-helper/**/review/reports/files/

# GraphFlow 工具的本地缓存（graphflow MCP 在工作目录运行时产生）
.graphflow-cache/

# OCR 运行时下载到仓库根目录的模型（rapidocr 缺模型时自行下载，不入库）
/*.onnx

/.merge-msg.txt

# 合并时写提交信息用的临时文件（勿提交）
/.merge-msg*.txt

# 提交信息临时文件（各种写法都不要提交）
/*-msg.txt
/.commit-msg*.txt

# 本地交易迁移原件包含身份凭据，禁止进入公开仓库
config/stock-exchange-migration-backups/
